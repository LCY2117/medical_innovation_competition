# Android SDK path.
# Copy this file to local.properties and change sdk.dir to your own machine path.
sdk.dir=C:\\Users\\LCY\\AppData\\Local\\Android\\Sdk

# ==============================
# LifeReflex Android runtime config
# ==============================
# REST API base URL. Must end with /.
LRA_API_BASE=https://lifereflex.mddcommunity.top/

# WebSocket endpoint for incident state streaming.
LRA_WS_BASE=wss://lifereflex.mddcommunity.top/ws

# ==============================
