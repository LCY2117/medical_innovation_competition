	const connectWs = (id) => {
		if (!id) {
			return;
		}
		manualCloseRef.current = false;
		const previousWs = wsRef.current;
		wsRef.current = null;
		previousWs?.close();
		if (reconnectTimeoutRef.current) {
			window.clearTimeout(reconnectTimeoutRef.current);
			reconnectTimeoutRef.current = null;
		}
		setWsError(null);
		const ws = new WebSocket(`${getWsBase()}?incidentId=${id}`);
		wsRef.current = ws;
		ws.onopen = () => {
			if (wsRef.current !== ws) {
				return;
			}
			reconnectAttemptRef.current = 0;
			setWsConnected(true);
			setWsError(null);
		};
		ws.onclose = () => {
			if (wsRef.current !== ws) {
				return;
			}
			setWsConnected(false);
			if (!manualCloseRef.current && id) {
				const attempt = reconnectAttemptRef.current;
				const delay = Math.min(1e4, 1e3 * Math.pow(2, attempt));
				reconnectAttemptRef.current += 1;
				reconnectTimeoutRef.current = window.setTimeout(() => connectWs(id), delay);
			}
		};
		ws.onerror = () => {
			if (wsRef.current === ws) {
				setWsError("WebSocket 连接异常");
			}
		};
		ws.onmessage = (event) => {
			if (wsRef.current !== ws) {
				return;
			}
			try {
				const msg = JSON.parse(event.data);
				if (msg?.type === "STATE") {
					const nextState = msg.payload;
					if (nextState?.incidentId === id) {
						setIncidentState((current) => mergeIncidentState(current, nextState));
					}
				} else if (msg?.type === "ERROR") {
					setWsError(String(msg.payload ?? "WebSocket error"));
				}
			} catch {
				setWsError("Invalid WebSocket message");
			}
		};
	};
