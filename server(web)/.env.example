# Backend bind
LRA_HOST=0.0.0.0
LRA_PORT=8080
LRA_RELOAD=false

# API and behavior
LRA_API_PREFIX=/api
LRA_SOS_DURATION_SEC=5
LRA_DISPATCH_DELAY_SEC=0
LRA_DISPATCH_LLM_BUDGET_SEC=1

# Optional public-demo hardening.
# If set, dashboard-only mutation/export endpoints require X-demo-Admin-Token.
LRA_demo_ADMIN_TOKEN=

# Optional formal admin accounts for production-like demos.
# Comma-separated phone numbers; the users must register/login normally.
# Matching accounts receive ["admin"] in /auth/me and can call admin APIs with Bearer tokens.
LRA_ADMIN_PHONES=

# Login session lifetime in seconds. Use 0 for non-expiring local demo tokens.
LRA_AUTH_TOKEN_TTL_SEC=604800

# Lightweight security controls.
# Audit log records login/demo/admin/export/role events in SQLite without storing secrets.
LRA_AUDIT_LOG_ENABLED=true
# Per-process sliding-window rate limits. Use 0 to disable a specific bucket.
LRA_RATE_LIMIT_ENABLED=true
LRA_RATE_LIMIT_AUTH_PER_MINUTE=20
LRA_RATE_LIMIT_ADMIN_PER_MINUTE=60
LRA_RATE_LIMIT_ACTOR_PER_MINUTE=120

# Push / notification provider.
# websocket = competition/demo fallback through existing WebSocket state sync.
# jpush/vendor = future adapter placeholders; fallback to websocket until credentials and review are ready.
LRA_PUSH_PROVIDER=websocket

# CORS (comma separated)
LRA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage and static hosting paths (relative to server(web)/)
LRA_DB_PATH=data/lifereflexarc.db
LRA_WEB_DIST_DIR=web/dist

# Web dev server (used by app.cli --with-web)
LRA_WEB_DEV_HOST=127.0.0.1
LRA_WEB_DEV_PORT=5173

# Optional AI dispatch provider
LRA_SILICONFLOW_API_KEY=
LRA_SILICONFLOW_MODEL=Qwen/Qwen2-7B-Instruct
LRA_SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
LRA_SILICONFLOW_TIMEOUT_SEC=8

# ==============================
# Map Provider / 地图服务配置
# ==============================
# Current map provider:
# demo = use built-in demo locations and mocked map behavior
# amap = use AMap/Gaode real map, geocoding, route, and distance services
# Keep real keys in .env or server environment only. Never commit secrets.
LRA_MAP_PROVIDER=demo

# ==============================
# AMap Web JS API / 高德网页端地图
# ==============================
# Usage:
# 1. Web dispatch dashboard map display
# 2. Mobile browser map/location display
# AMap console platform type: Web端(JS API)
LRA_AMAP_WEB_KEY=

# AMap JS API security code.
# Required by recent AMap JS API keys.
# Do not expose this in source control; production should proxy or inject safely.
LRA_AMAP_WEB_SECURITY_JS_CODE=

# ==============================
# AMap Web Service API / 高德服务器端接口
# ==============================
# Usage:
# 1. Server-side reverse geocoding
# 2. Distance/route planning
# 3. Real spatial distance scoring for dispatch
# AMap console platform type: Web服务
LRA_AMAP_SERVICE_KEY=
LRA_MAP_DISTANCE_TIMEOUT_SEC=3

# ==============================
# OPPO Health / OPPO 健康增强
# ==============================
# mock = always use built-in demo health summaries
# oppo = enable OPPO Health provider when official approval, SDK/API credentials,
#        privacy disclosure, and user authorization are ready
LRA_HEALTH_PROVIDER=mock

# Server-side OPPO cloud API placeholders. Keep real values in .env or secret storage only.
LRA_OPPO_HEALTH_CLIENT_ID=
LRA_OPPO_HEALTH_CLIENT_SECRET=
LRA_OPPO_HEALTH_REDIRECT_URI=

# Optional local model (prefer local when configured)
# Set to your local model service base URL (example provided by model_training)
# Example: http://localhost:8008/v1
LRA_LOCAL_MODEL_BASE_URL=
# Local model name (used in probes/requests)
LRA_LOCAL_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
# Local model request timeout (seconds)
LRA_LOCAL_MODEL_TIMEOUT_SEC=30
# If true, try local model first, then remote API. If false, remote API first.
LRA_PREFER_LOCAL_MODEL=true
